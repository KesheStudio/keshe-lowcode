# [LC-GENERATED] 平台生成区：重新生成会整块替换，不要在这里手改。
# 复制为 .env 后按需修改；环境变量优先级高于 config.yaml，低于启动参数。
# .env 已被 .gitignore 忽略，不要提交。
# 安全红线：不要连接本机已有的数据库实例。示例刻意避开 3306/3307/5432/6379；
# 需要验证时只允许临时隔离实例（独立端口、独立空目录、独立空库、一次性密码），用完立即停止并删除。

# 监听地址与端口（对应配置项 host / port）
LC_HOST=127.0.0.1
LC_PORT=8080

# 日志级别：debug / info / warn / error
LC_LOG_LEVEL=info

# CORS 白名单，逗号分隔；留空表示不开放跨域，填 * 表示允许所有来源
LC_CORS_ORIGINS=

# 数据库：url 非空时优先，scheme 决定驱动（sqlite:// / mysql:// / postgres://）
# SQLite 示例：sqlite://data/app.db（目录和文件会自动创建）
# MySQL 示例：mysql://app@db.example.com:13306/app?ssl-mode=disabled（占位主机，仅替换为目标库）
# PG  示例：postgres://app@db.example.com:15432/app?sslmode=disable
DATABASE_URL=sqlite://data/app.db

# 不想用 URL 时，用下面这些字段拼装（url 留空才生效）
# LC_DB_DRIVER=sqlite
# LC_DB_HOST=127.0.0.1
# LC_DB_PORT=0
# LC_DB_NAME=app
# LC_DB_USER=
# 数据库密码只放环境变量，不要写进 config.yaml 或提交到仓库
# LC_DB_PASSWORD=
# LC_DB_SSL_MODE=disable
# LC_DB_MAX_OPEN_CONNS=10
# LC_DB_CONNECT_TIMEOUT=5

# 缓存：none / memory / redis；redis 不可用时自动降级 memory，服务照常启动
LC_CACHE_DRIVER=memory
# 示例端口刻意避开 6379；只填隔离实例的地址
REDIS_URL=redis://127.0.0.1:16379/0
LC_CACHE_TTL_SECONDS=30

# 是否同时把 ../web 作为静态资源根
LC_STATIC_ENABLED=false

# 指定配置文件路径（相对启动目录）
# LC_CONFIG_FILE=config.yaml

# 设为 true 时跳过 config.generated.yaml，只用 config.yaml + 环境变量
LC_OVERRIDE=false

# 站点名，只影响 /api/meta 的展示
LC_SITE_NAME=低代码站点
