{
  "name": "lowcode-backend-node",
  "version": "0.1.0",
  "private": true,
  "description": "低代码平台导出的 Node 后端骨架（full 档）",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/main.js",
    "migrate": "node src/main.js --migrate",
    "migrate:down": "node src/main.js --migrate-down",
    "check": "node scripts/check-user.mjs",
    "manifest": "node scripts/generated-manifest.mjs"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "@fastify/static": "8.3.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  }
}
