# 本机配置，复制为 .env 后按需改；模板不会读取 .env，下面只是给部署脚本和用户看的对照表
# 真正的优先级：内置默认 < config.generated.yaml < config.yaml < 环境变量 < 启动参数
# 安全红线：不要连接本机已有的数据库实例。示例刻意避开 3306/3307/5432/6379；
# 需要验证时只允许临时隔离实例（独立端口、独立空目录、独立空库、一次性密码），用完立即停止并删除。

# 配置文件路径（默认先找 ../deploy/backend/config.yaml，再找 ./config.yaml）
LC_CONFIG_FILE=../deploy/backend/config.yaml

# 监听地址与端口
LC_HOST=127.0.0.1
LC_PORT=8080

# 日志级别：debug / info / warn / error
LC_LOG_LEVEL=info

# 跨域来源，逗号分隔；留空表示不放开跨域
LC_CORS_ORIGINS=

# 数据库：DATABASE_URL 写全 DSN 时优先级最高，scheme 决定驱动
# sqlite://data/app.db | mysql://user:pass@db.example.com:13306/app | postgres://user:pass@db.example.com:15432/app
DATABASE_URL=sqlite://data/app.db
# 不使用 DATABASE_URL 时用下面这些分项字段
LC_DB_DRIVER=sqlite
LC_DB_HOST=127.0.0.1
LC_DB_PORT=0
LC_DB_NAME=app
LC_DB_USER=
# 密码只放环境变量，不要写进 config.yaml 或提交到仓库
LC_DB_PASSWORD=
LC_DB_SSL_MODE=disable
LC_DB_MAX_OPEN_CONNS=10
LC_DB_CONNECT_TIMEOUT=5

# 可选缓存：none / memory / redis；Redis 不可用时自动降级内存
LC_CACHE_DRIVER=memory
# 示例端口刻意避开 6379；只填隔离实例的地址
REDIS_URL=redis://127.0.0.1:16379/0
LC_CACHE_TTL_SECONDS=30

# 只跑后端（无 nginx）时设为 true，由后端自己服务 ../web
LC_STATIC_ENABLED=false

# 让 config.yaml 整体覆盖 config.generated.yaml
LC_OVERRIDE=false
